# Server environment only. Never prefix Supabase secrets with VITE_.
SUPABASE_URL=https://gmdcappxvfghnqmbrbio.supabase.co
# Supabase publishable key (or legacy anon key); used as the public Auth API key.
SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
# Secret key (or legacy service_role key). Keep only in server environment.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_WITH_YOUR_SECRET_KEY

# Optional: needed only for the AI consultant.
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-2.5-flash
